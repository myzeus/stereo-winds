# Generated figure artifacts.
# NOTE: .gitignore does not affect already-tracked files, so the paper figures
# committed under figures/ stay tracked and updatable. These rules only stop
# the hundreds of regenerated/scratch renders from being swept in by
# `git add -A`. To commit a NEW figure on purpose: git add -f figures/<name>
figures/_*
figures/*.png
figures/*.pdf
figures/*.svg
figures/*.gif
figures/*.npz
figures/*.txt
figures/*.parquet
figures/*/

# Scratch analysis outputs at the repo root
merged_geo_map.html
sorcerer_flight_stats.csv
*_quad_matches.npz
quad_matches*.npz

# Training run logs
wandb/
*.log

# Local notebooks scratch
.ipynb_checkpoints/
